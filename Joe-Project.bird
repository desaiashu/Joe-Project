sig
  bpm 130
  system 12tet western
  scale C chromatic

arr
  main 32 |myk

tracks
  1 Chicago sketch 10-Mini V3 |fgu
    type audio
    strip tivraStrip
  2 MIDI |ugc
    type midi
    plugin tivraWavetable
    strip tivraStrip

returns
  0 Hall |rlp
    fx tivraHall
    strip tivraStrip
  1 Plate |rmy
    fx tivraPlate
    strip tivraStrip
  2 Delay |rmr
    fx tivraDelay
    strip tivraStrip
  3 Color |rrt
    fx tivraDistortion
    strip tivraStrip

master
  strip tivraMastering

sec main
  trk 1 Chicago sketch 10-Mini V3 |fgu
    c 0:302 34:256 |gnzf
      'samples/Chicago sketch 10-Mini V3.wav'
  trk 2 MIDI |ugc
    c 1:0 1:0 |ejii
      p _xx s _xx _s s _xxd s _xxd s _xxd _s
        v 100
        n A3 B3
